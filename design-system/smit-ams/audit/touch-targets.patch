diff --git a/client/src/index.css b/client/src/index.css
index b03b0ad..2e103d2 100644
--- a/client/src/index.css
+++ b/client/src/index.css
@@ -171,3 +171,38 @@
     scroll-behavior: auto !important;
   }
 }
+
+/*
+ * Touch-target floor.
+ *
+ * The compact control scale (32px sm buttons, 34-36px icon buttons) reads well
+ * with a mouse but falls under the 44px comfortable-touch minimum, so on a
+ * touch device the topbar controls and card actions are hard to hit reliably.
+ *
+ * Gated on `pointer: coarse` rather than a width breakpoint on purpose: the
+ * constraint is the input device, not the viewport. A touch laptop at 1440px
+ * needs the larger target; a 375px-wide desktop window does not.
+ */
+@media (pointer: coarse) {
+  button,
+  [role='button'],
+  [role='radio'],
+  [role='tab'],
+  select,
+  input:not([type='checkbox']):not([type='radio']) {
+    min-block-size: 44px;
+  }
+
+  /* Icon-only controls carry no text to stretch them, so pin the inline axis too. */
+  .icon-btn {
+    min-inline-size: 44px;
+  }
+
+  /* Text links that act as controls -- card-header actions, marketing nav --
+     are only as tall as their line box, so give them a tappable height.
+     Deliberately does NOT set `display`: that would override a utility such
+     as `hidden`, forcing controls back on screen at widths that hide them. */
+  .tap {
+    min-block-size: 44px;
+  }
+}
